# Copy into your hosting provider's secrets, never commit real values.
XPUMP_CONFIG=config.toml
# Every config.toml setting supports an XPUMP_ environment override.
# Comma-separated numeric IDs, e.g. XPUMP_AUTHOR_IDS=123,456.
XPUMP_AUTHOR_IDS=
XPUMP_X_ENABLED=false
XPUMP_CONFIGURE_X_ON_START=false
# Free website: xpump web; public embed source is experimental and preview-only.
XPUMP_FREE_HOSTING=true
XPUMP_PUBLIC_X_ACCOUNTS=realDonaldTrump:25073877,elonmusk:44196397
XPUMP_PUBLIC_X_POLL_SECONDS=60
# Required only for the official X stream / rule configuration:
X_BEARER_TOKEN=
# Required only for live launches; local Solana CLI JSON keypair, chmod 600:
XPUMP_WALLET_FILE=/run/secrets/launcher-wallet.json
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PINATA_JWT=
# Additional explicit live gate, alongside mode=live and positive SOL caps:
XPUMP_ENABLE_MAINNET=false
